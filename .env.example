# --- НАСТРОЙКИ БЕЗОПАСНОСТИ DJANGO ---
SECRET_KEY=django-insecure-insert-your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,web

# --- СУБД POSTGRESQL (ДЛЯ КОНТЕЙНЕРА DB) ---
DB_NAME=dating_db
DB_USER=dating_user
DB_PASSWORD=your_secure_password_here
DB_HOST=db
DB_PORT=5432

# --- БРОКЕР СООБЩЕНИЙ REDIS (ДЛЯ АСИНХРОННЫХ ЧАТОВ) ---
REDIS_HOST=redis
REDIS_PORT=6379
